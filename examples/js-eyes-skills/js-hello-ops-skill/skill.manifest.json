{
  "manifestVersion": 2,
  "id": "js-hello-ops-skill",
  "name": "JS Hello Ops Skill",
  "version": "1.0.0",
  "publisher": "example",
  "description": "JS Eyes Skills 最小样例：一个 hello_get_title 工具，读取标签页标题。",
  "entry": "./skill.entry.js",
  "compatibility": {
    "jsEyes": ">=2.8.5 <3",
    "contractApi": "^2.0.0",
    "runtimeApi": "^2.0.0",
    "node": ">=22"
  },
  "requirements": {
    "server": true,
    "browserExtension": true,
    "login": false,
    "platforms": [
      "*"
    ]
  },
  "capabilities": {
    "browser": [
      "tabs.read",
      "page.read",
      "navigation"
    ],
    "network": {
      "direct": false,
      "hosts": []
    },
    "filesystem": [
      "skillData"
    ],
    "process": [],
    "secrets": [],
    "background": false
  },
  "cli": {
    "entry": "./cli/index.js",
    "commands": [
      {
        "name": "title",
        "description": "读取指定标签页的标题"
      }
    ]
  },
  "tools": [
    {
      "name": "hello_get_title",
      "title": "Hello Ops: Get Page Title",
      "description": "读取指定标签页的 title 与 url。用于演示 JS Eyes Skills 最小 V2 契约。",
      "risk": "read",
      "capabilities": [
        "browser.tabs.read",
        "browser.page.read",
        "browser.navigation"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "tabId": {
            "type": "number",
            "description": "标签页 ID（通过 browser_list_tabs / browser/get-tabs 获取）"
          },
          "target": {
            "type": "string",
            "description": "目标浏览器 clientId 或名称（如 firefox/chrome）"
          }
        },
        "required": [
          "tabId"
        ]
      }
    }
  ]
}
