# js-x-ops-skill environment (copy to .env and fill in)

# Official API credentials (https://console.x.com)
# X_BEARER_TOKEN=
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=

# Official API proxy (Node outbound only; browser uses Chrome proxy)
# Priority: JS_X_OPS_PROXY > HTTPS_PROXY > HTTP_PROXY > ALL_PROXY
# Supports http(s):// and socks5:// (not socks4)
# Use off/none/direct to force direct connection
JS_X_OPS_PROXY=

# Examples:
# JS_X_OPS_PROXY=http://127.0.0.1:7890
# JS_X_OPS_PROXY=socks5://127.0.0.1:1080
# ALL_PROXY=socks5://127.0.0.1:1080

# Standard fallbacks (optional if JS_X_OPS_PROXY is set)
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# Skip loading .env files from parent directories
# JS_X_SKIP_DOTENV=1

# Browser bridge request timeout (seconds)
# JS_X_OPS_REQUEST_TIMEOUT=1800
