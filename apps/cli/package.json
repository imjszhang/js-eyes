{
  "name": "js-eyes",
  "version": "2.12.0",
  "description": "JS Eyes CLI, local browser automation server, Native Messaging host, and MCP server",
  "main": "src/cli.js",
  "exports": {
    ".": "./src/cli.js",
    "./server-core": "./server-core/index.js",
    "./server-core/*": "./server-core/*.js",
    "./server-core/*.js": "./server-core/*.js",
    "./native-host": "./native-host/src/index.js",
    "./native-host/bin/js-eyes-native-host.js": "./native-host/bin/js-eyes-native-host.js",
    "./native-host/*": "./native-host/src/*.js",
    "./native-host/*.js": "./native-host/src/*.js",
    "./mcp-server": "./mcp-server/index.js",
    "./mcp-server/*": "./mcp-server/src/*.js",
    "./mcp-server/*.js": "./mcp-server/src/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/*/*.test.js"
  },
  "files": [
    "bin/",
    "src/",
    "server-core/",
    "native-host/",
    "mcp-server/"
  ],
  "bin": {
    "js-eyes": "bin/js-eyes.js",
    "js-eyes-mcp": "bin/js-eyes-mcp.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "author": "imjszhang <ortle3x3@gmail.com>",
  "homepage": "https://js-eyes.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imjszhang/js-eyes.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/imjszhang/JS-Eyes/issues"
  },
  "keywords": [
    "js-eyes",
    "browser-automation",
    "mcp",
    "cli",
    "skills",
    "openclaw"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@js-eyes/client-sdk": "2.12.0",
    "ws": "^8.19.0",
    "zod": "^4.6.7"
  }
}
