{
  "name": "@js-eyes/openclaw-plugin",
  "version": "2.11.1",
  "description": "Optional OpenClaw plugin adapter for JS Eyes (peer host surface)",
  "type": "module",
  "main": "index.mjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "*.mjs",
    "actions/",
    "fs-utils/",
    "openclaw.plugin.json"
  ],
  "license": "MIT",
  "dependencies": {
    "@js-eyes/client-sdk": "2.11.1",
    "@js-eyes/config": "2.11.1",
    "@js-eyes/native-host": "2.11.1",
    "@js-eyes/protocol": "2.11.1",
    "@js-eyes/runtime-paths": "2.11.1",
    "@js-eyes/server-core": "2.11.1",
    "@js-eyes/skill-install": "2.11.1",
    "@js-eyes/skill-runtime": "2.11.1",
    "chokidar": "^3.6.0"
  },
  "peerDependencies": {
    "openclaw": ">=0.0.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.mjs"
    ]
  }
}
